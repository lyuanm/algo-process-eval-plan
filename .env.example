# ===== 大模型接入配置（切勿把真实密钥提交进仓库）=====
# 选择接入方式：local=开源 Hy3(OpenAI兼容) / cloud=腾讯云 Hunyuan 商业 API
HY3_PROVIDER=cloud

# ---- 方式一：开源 Hy3（本地/远端 vLLM·SGLang 部署，OpenAI 兼容）----
HY3_BASE_URL=http://127.0.0.1:8000/v1
HY3_API_KEY=your-hy3-api-key-or-EMPTY
HY3_MODEL=hy3

# ---- 方式二：腾讯云 Hunyuan 商业 API（hunyuan.tencentcloudapi.com）----
# 在腾讯云控制台「访问管理 → API密钥管理」获取 SecretId / SecretKey
HUNYUAN_SECRET_ID=your-secret-id
HUNYUAN_SECRET_KEY=your-secret-key
HUNYUAN_MODEL=hunyuan-pro          # 可选 hunyuan-pro / hunyuan-turbo / hunyuan-standard / hunyuan-lite / hunyuan-thinking
HUNYUAN_REGION=ap-guangzhou

# 推理强度（仅 Hy3/local 使用；腾讯云 Hunyuan 暂未使用该字段）
HY3_REASONING_EFFORT=high

# 离线演示模式（on=强制 Mock，不联网）：on / off
OFFLINE_MODE=on
